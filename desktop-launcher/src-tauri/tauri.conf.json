{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FORBIDDENS",
  "version": "0.1.3",
  "identifier": "app.forbiddens.launcher",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "https://forbiddens.net/",
    "frontendDist": "../launcher-fallback"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FORBIDDENS",
        "url": "https://forbiddens.net/",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "../icons/icon.ico",
      "../icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "../icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://forbiddens.net/desktop/latest.json"
      ],
      "pubkey": "REEMPLAZAR_CON_LA_CLAVE_PUBLICA_DEL_UPDATER"
    }
  }
}
