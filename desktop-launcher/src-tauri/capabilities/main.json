{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main launcher permissions",
  "windows": ["main"],
  "webviews": ["main"],
  "remote": {
    "urls": [
      "https://forbiddens.net",
      "https://forbiddens.net/*",
      "https://www.forbiddens.net",
      "https://www.forbiddens.net/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "updater:default",
    "allow-launcher-bridge"
  ]
}
